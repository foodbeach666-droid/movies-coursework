@startuml
skinparam classAttributeIconSize 0

class Movie {
  - id: Long
  - title: String
  - director: String
  - releaseYear: Integer
  - genre: String
  - boxOffice: Double
  - createdBy: String
  - actors: List<Actor>
  + getters/setters()
}

class Actor {
  - id: Long
  - name: String
  - roleName: String
  - fee: Double
  - movie: Movie
  + getters/setters()
}

class User {
  - id: Long
  - username: String
  - password: String
  - roles: Set<Role>
  + getters/setters()
}

